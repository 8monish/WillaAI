{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WillaAI",
  "version": "0.3.0",
  "identifier": "com.zerosones.willa",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WillaAI",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Fast, lightweight agentic AI environment",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "WillaAI"
      }
    },
    "createUpdaterArtifacts": true,
    "publisher": "Zeros&oneS",
    "copyright": "\u00a9 2026 Zeros&oneS. MIT License."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlEREJFREVCRUI1MzgyMTYKUldRV2dsUHI2KzNiblJMb3ZvVUx6aUZlY2Vhb29ib1NpbmU1cWZ2bVZLQTVmRXQ1TWJUTVQ2NEYK",
      "endpoints": [
        "https://github.com/8monish/WillaAi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}