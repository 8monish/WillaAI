# ========================================================
# RipeAI WhatsApp Remote Terminal & Agent Configuration
# ========================================================

# 1. [REQUIRED / RECOMMENDED] Your Personal WhatsApp Number
# Specify the exact phone number (with country code, digits only) you will control your machine from.
# Examples: 919876543210 (India), 15551234567 (US)
# - The bot will strictly accept commands ONLY from this DM!
# - Upon connection, the bot will automatically send a "Hi!" handshake message to this number.
# - (If left empty, it will automatically pair with the first number that sends it a message).
# - Specify comma-separated phone numbers if controlling from multiple accounts.
OWNER_PHONE_NUMBER=919361430509,919363936963

# Automatically send a "Hi! RipeAI is online" greeting to the owner upon connecting (true / false)
SEND_GREETING_ON_READY=true

# ========================================================
# AI Engine Selection (Uses the Local RipeAI AI Agent by default)
# ========================================================
# Choose engine: 'agy' (native local Gemini agent with system tools) or 'openai' (remote API)
AI_ENGINE=agy

# Local Gemini model used by the 'agy' system agent
AGY_MODEL=gemini-3.8-flash-high

# Project workspace directory to run commands and file operations in (defaults to RipeAI root)
RIPEAI_WORKSPACE=

# ========================================================
# Remote OpenAI Settings (Only needed if AI_ENGINE=openai)
# ========================================================
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ========================================================
# Session Management & Persistence
# ========================================================
SESSION_DATA_PATH=./.wweb_auth

# ========================================================
# Message Trigger (Optional)
# ========================================================
# Leave empty ("") so every message in your DM controls your system.
# Or set a prefix like "!ai " if you only want it to respond when prefixed.
TRIGGER_PREFIX=

# Run browser in headless mode (true / false)
HEADLESS=true
